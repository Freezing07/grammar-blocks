          "pos": "noun",
          "role": "表语",
          "group": "np2"
        }
      ],
      "distractors": [
        {
          "text": "us",
          "pos": "pronoun",
          "role": "限定词",
          "group": "np2"
        },
        {
          "text": "ours",
          "pos": "pronoun",
          "role": "表语",
          "group": "np2"
        }
      ],
      "explain": "名词 school 前面要用物主代词 our。us 是宾格，只能跟在动词或介词后面（help us）；ours 相当于「我们的学校」，它自己就代替了名词，后面不能再跟 school。",
      "example": "This is our school. / This school is ours.",
      "win": "物主代词 + 名词；名词性的那个自己就够。"
    },
