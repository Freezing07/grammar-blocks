        }
      ],
      "blocks": [
        {
          "text": "He",
          "pos": "pronoun",
          "role": "主语",
          "group": "np1"
        },
        {
          "text": "is",
          "pos": "verb",
          "role": "谓语",
          "group": "vp"
        },
        {
          "text": "my",
          "pos": "pronoun",
          "role": "限定词",
          "group": "np2"
        },
        {
          "text": "brother",
          "pos": "noun",
          "role": "表语",
          "group": "np2"
        }
      ],
      "distractors": [
        {
          "text": "Him",
          "pos": "pronoun",
          "role": "主语",
          "group": "np1"
        },
        {
          "text": "His",
          "pos": "pronoun",
          "role": "限定词",
          "group": "np2"
        }
      ],
      "explain": "句首主语只能用主格 He，不能用宾格 Him。my 是「我的」，后面必须跟名词 brother。",
      "example": "He is my brother. / I know him. / His brother is tall.",
      "win": "主语用主格，名词前面用物主代词。"
    },
