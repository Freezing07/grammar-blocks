          "pos": "noun",
          "role": "被强调部分",
          "group": "np2"
        },
        {
          "text": "who",
          "pos": "pronoun",
          "role": "关系词",
          "group": "cl"
        },
        {
          "text": "broke",
          "pos": "verb",
          "role": "谓语",
          "group": "cl"
