          "text": "It",
          "pos": "pronoun",
          "role": "形式主语",
          "group": "np1"
        },
        {
          "text": "is",
          "pos": "verb",
          "role": "谓语",
          "group": "vp"
        },
        {
          "text": "you",
          "pos": "pronoun",
          "role": "被强调部分",
          "group": "np2"
        },
        {
          "text": "that",
          "pos": "pronoun",
