          "parent": "vp"
        }
      ],
      "blocks": [
        {
          "text": "I",
          "pos": "pronoun",
          "role": "主语",
          "group": "np1"
        },
        {
          "text": "enjoy",
          "pos": "verb",
          "role": "谓语",
          "group": "vp"
        },
        {
          "text": "reading",
          "pos": "verb",
          "role": "动名词",
          "group": "ger",
          "nonfinite": true
        },
        {
          "text": "books",
          "pos": "noun",
          "role": "宾语",
          "group": "ger"
        }
      ],
      "distractors": [
        {
          "text": "read",
          "pos": "verb",
          "role": "动名词",
          "group": "ger"
        },
        {
          "text": "to",
          "pos": "inf",
          "role": "不定式符号",
          "group": "ger"
        }
      ],
      "explain": "enjoy 后面只能跟动名词：enjoy reading。不能说 enjoy to read —— 这是必须一个个记住的固定搭配。类似的还有 finish / mind / practice / suggest。",
      "example": "I enjoy reading books. / I want to read books.",
      "win": "enjoy 后面跟动名词，不跟不定式。"
    },
