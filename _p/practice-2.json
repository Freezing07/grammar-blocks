    ],
    "patterns": [
      [["adv", "引导词", "ex"], ["verb", "谓语", "vp"], ["article", "限定词", "np1"], ["noun", "主语", "np1"], ["prep", "介词", "pp"], ["article", "限定词", "pp"], ["noun", "介词宾语", "pp"]],
